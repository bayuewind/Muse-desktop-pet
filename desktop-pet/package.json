{
  "name": "muse-desktop-pet",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Local-only Muse desktop companion with an isolated login session",
  "author": "bayuewind",
  "homepage": "https://github.com/bayuewind/Muse-desktop-pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/bayuewind/Muse-desktop-pet.git"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "native": "electron . --native",
    "native:stdin": "node native/monitor.cjs",
    "pair:native": "electron native/pair.cjs --approved-session-export",
    "probe:native": "electron native/probe.cjs",
    "verify:native": "electron native/complete-pair.cjs --approved-session-export",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "smoke:workspace": "electron . --smoke-test --workspace-test",
    "smoke:browser": "node scripts/browser-smoke.cjs",
    "pack:win": "electron-builder --win --x64 --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "verify:win": "node scripts/verify-package.cjs",
    "icons": "electron scripts/prepare-icons.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "lucide": "1.48.0",
    "protobufjs": "8.8.0",
    "puppeteer-core": "25.12.0",
    "tough-cookie": "6.0.2",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
